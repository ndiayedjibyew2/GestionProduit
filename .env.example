# En ligne (Vercel) : URL de connexion Postgres Supabase (pooler, mode "Transaction", port 6543)
# Supabase > bouton "Connect" > "Transaction pooler" — remplacer [YOUR-PASSWORD] par le mot de passe de la base.
DATABASE_URL=postgresql://postgres.<ref-projet>:<mot-de-passe>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# En local (XAMPP), rien à définir : MySQL localhost / root / sans mot de passe / base gestion_produits.
# Variables optionnelles : DB_HOST, DB_NAME, DB_USER, DB_PASS
